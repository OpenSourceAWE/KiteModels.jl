#!/bin/bash -eu
# SPDX-FileCopyrightText: 2025, 2026 Uwe Fechner
# SPDX-License-Identifier: MIT
#
# This script creates a precompiled system image for faster startup of the examples.
# It is used when the package is installed via the package manager and the
# examples are installed with install_examples().

update=false
if [[ $# -gt 0 ]]; then
    if [[ $1 != "--update" ]]; then
        echo "Invalid parameter! Use:"
        echo "./create_sys_image"
        echo "or"
        echo "./create_sys_image --update"
        exit 1
    else
        update=true
    fi
fi

if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

# Check the memory and choose the number of image threads; the rules are documented in
# docs/sysimage.md. This runs before anything else, so that a machine with too little memory
# fails right away.

# Stop if RAM + swap is not enough even for one image thread (measured peak about 26 GB, plus
# a few GB of margin). Only on Linux, where both are fixed; on Windows the pagefile and on
# macOS the swap can grow, which test/create_sys_image.jl takes into account.
if [[ "$OSTYPE" == linux* ]]; then
    _total_mb=$(awk '/^(MemTotal|SwapTotal):/ {s += $2} END {printf "%i", s / 1024}' /proc/meminfo)
    if [[ $_total_mb -lt 30720 ]]; then
        echo "Error: At least 30 GB of RAM + swap is needed to create a system image, but only $(( _total_mb / 1024 )) GB is available." >&2
        echo "Increase your swap file and retry." >&2
        exit 1
    fi
fi

# Physical memory in MB
totalmem=""
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
    echo "Checking system memory on Windows..."
    totalmem=$(powershell.exe -Command "(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1MB" 2>/dev/null | awk '{printf "%i", $1}')
    limit_27gb=27000
    min_ram_mb=15000 min_ram_gb=15
elif [[ "$OSTYPE" == darwin* ]]; then
    echo "Checking system memory on macOS..."
    totalmem=$(sysctl -n hw.memsize 2>/dev/null | awk '{printf "%i", $1 / 1000000}')
    limit_27gb=27000
    min_ram_mb=7000 min_ram_gb=7
else
    totalmem=$(grep MemTotal /proc/meminfo | awk '{printf "%i", $2 / 1024}')
    limit_27gb=26674
    min_ram_mb=15000 min_ram_gb=15
fi

# 15000 MB, because a 16 GB machine reports a little less than 16 GB; on macOS 7000 MB, so
# that Macs with 8 GB of RAM can build the image, swapping to the free disk space
if [[ -z "$totalmem" ]]; then
    echo "Warning: Could not determine the size of the RAM."
elif [[ $totalmem -lt $min_ram_mb ]]; then
    echo "Error: At least $min_ram_gb GB of RAM is needed to create a system image, but only $(( totalmem / 1024 )) GB is available." >&2
    exit 1
fi

# The build needs about 26 GB with one image thread and about 30 GB with two or more, so
# with less than 27 GB of RAM two threads are used (one with fewer than 4 CPU threads).
# test/create_sys_image.jl chooses the number of threads in all other cases; it uses one
# thread if RAM + swap is less than 34 GB, also if two were chosen here.
if [[ -n "${JULIA_IMAGE_THREADS:-}" ]]; then
    echo "JULIA_IMAGE_THREADS already set to $JULIA_IMAGE_THREADS, leaving as is"
elif [[ -z "$totalmem" ]]; then
    export JULIA_IMAGE_THREADS=1 SYSIMAGE_THREADS_AUTO=true
    echo "Using only one thread for sysimage compilation."
elif [[ $totalmem -lt $limit_27gb ]]; then
    _cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo "${NUMBER_OF_PROCESSORS:-2}")
    if [[ $_cpus -ge 4 ]]; then
        export JULIA_IMAGE_THREADS=2
    else
        export JULIA_IMAGE_THREADS=1
    fi
    export SYSIMAGE_THREADS_AUTO=true
    echo "Less than 27GB of memory detected. Using $JULIA_IMAGE_THREADS thread(s) for sysimage compilation."
fi

julia_version=$(julia --version | awk '{print($3)}')
julia_major=${julia_version:0:3} 
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4} 
fi
if test -f "kps-image-${julia_major}.so"; then
    mv bin/kps-image-${julia_major}.so kps-image-${julia_major}.so.bak
fi

if [[ $update == true ]]; then
    echo "Updating packages..."
    if test -f "Manifest.toml"; then
        mv Manifest.toml Manifest.toml.bak
    fi
    if test -f "Manifest-v1.10.toml"; then
        mv Manifest-v1.10.toml Manifest-v1.10.toml.bak
    fi
    if test -f "Manifest-v1.11.toml"; then
        mv Manifest-v1.11.toml Manifest-v1.11.toml.bak
    fi
    if test -f "Manifest-v1.12.toml"; then
        mv Manifest-v1.12.toml Manifest-v1.12.toml.bak
    fi
    if test -f "Manifest-v1.13.toml"; then
        mv Manifest-v1.13.toml Manifest-v1.13.toml.bak
    fi
    julia --project -e "include(\"./test/update_packages.jl\");"
else
    echo "Using existing manifest file!"
fi
echo "Instantiating packages..."
julia --startup-file=no --project -e "using Pkg; Pkg.instantiate();"

# Run Pkg.precompile() and fail if either Julia exits non-zero or the output
# contains package-level precompile failure markers.
run_precompile() {
    local _proj="$1"
    local _plog
    _plog=$(mktemp)
    set +e
    julia --startup-file=no ${_proj} -e 'using Pkg; Pkg.precompile()' 2>&1 | tee "$_plog"
    _precompile_rc=${PIPESTATUS[0]}
    set -e
    if [[ $_precompile_rc -ne 0 ]] || \
       sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' "$_plog" | grep -qE "Failed to precompile|dependencies? errored"; then
        echo "ERROR: Precompilation failed for ${_proj}. See log above."
        rm -f "$_plog"
        exit 1
    fi
    rm -f "$_plog"
}

print_memory_snapshot() {
    echo "Memory snapshot:"
    if [[ "$(uname -s)" == "Linux" ]]; then
        awk '/MemTotal|MemAvailable|SwapTotal|SwapFree/ {printf "  %s %s %s\n", $1, $2, $3}' /proc/meminfo
        if [[ -r /sys/fs/cgroup/memory.max ]]; then
            local _cmax _ccur
            _cmax=$(cat /sys/fs/cgroup/memory.max 2>/dev/null || true)
            _ccur=$(cat /sys/fs/cgroup/memory.current 2>/dev/null || true)
            echo "  cgroup memory.max: ${_cmax:-unknown}"
            echo "  cgroup memory.current: ${_ccur:-unknown}"
        fi
    else
        echo "  Memory diagnostics are only implemented for Linux in this script."
    fi
}

echo "Precompiling packages.."
run_precompile "--project"
echo "Creating system image..."
print_memory_snapshot
set +e
julia --project -e "include(\"./test/create_sys_image.jl\");"
_sysimg_rc=$?
set -e
if [[ $_sysimg_rc -ne 0 ]]; then
    echo "ERROR: System image creation failed with exit code $_sysimg_rc"
    print_memory_snapshot
    if [[ $_sysimg_rc -eq 137 ]]; then
        echo "Hint: exit code 137 often indicates the process was killed by the OOM killer."
    else
        echo "Hint: enable detailed logs with: JULIA_DEBUG=PackageCompiler ./bin/create_sys_image2"
    fi
    exit $_sysimg_rc
fi
mv kps-image_tmp.so bin/kps-image-${julia_major}.so
run_precompile "--project"
