#!/bin/bash -eu
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

# Updates all packages with the Julia on the PATH and writes the result to
# Manifest-v<major>.toml.default. Choose another Julia with e.g.
# JULIAUP_CHANNEL=1.12 ./update_default_manifest

if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

bin/install --update

julia_major=$(bin/julia_major)
cp "Manifest-v${julia_major}.toml" "Manifest-v${julia_major}.toml.default"
echo "Updated Manifest-v${julia_major}.toml.default !"
