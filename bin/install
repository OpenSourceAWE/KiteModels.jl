#!/bin/bash -eu
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

update=false

print_usage() {
    echo "Usage: ./install [--update] [-y] [-h]"
    echo
    echo "Installs the packages pinned in Manifest-v<major>.toml.default with the Julia on"
    echo "the PATH and precompiles them. Choose another Julia with JULIAUP_CHANNEL, e.g."
    echo "JULIAUP_CHANNEL=1.12 ./install"
    echo
    echo "  --update   update the packages in the live manifest; the .default is untouched"
    echo "  -y, --yes  run without asking anything (the default, kept for scripts)"
    echo "  -h, --help show this help"
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            print_usage
            exit 0
            ;;
        --update)
            update=true
            shift
            ;;
        -y|--yes)
            shift
            ;;
        *)
            echo "Invalid parameter!"
            print_usage
            exit 1
            ;;
    esac
done

if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

if ! command -v julia &> /dev/null; then
    echo "Error: julia is not on the PATH. Install it with juliaup first:"
    echo "  https://github.com/JuliaLang/juliaup"
    exit 1
fi

julia_version=$(julia --version)
julia_version=${julia_version##* }
julia_major=$(echo "$julia_version" | cut -d. -f1,2)
echo "Using Julia $julia_version"

case $julia_major in
    1.11|1.12|1.13) ;;
    *)
        echo "Error: Julia $julia_major is not supported, only 1.11, 1.12 and 1.13."
        echo "Install one with juliaup and select it with e.g. JULIAUP_CHANNEL=1.11 ./install"
        exit 1
        ;;
esac

export JULIA_PKG_SERVER_REGISTRY_PREFERENCE=eager

# A system image built against the previous manifest is stale.
SOFILE="bin/kps-image-${julia_major}.so"
if test -f "$SOFILE"; then
    echo "Deleting old system image: $SOFILE"
    rm -f "$SOFILE"
fi

manifest="Manifest-v${julia_major}.toml"
if [ ! -f "${manifest}.default" ]; then
    echo "Error: ${manifest}.default not found"
    exit 1
fi
if [[ $update == true ]]; then
    [ -f "$manifest" ] || cp "${manifest}.default" "$manifest"
    echo "Updating the packages in $manifest..."
    julia --project -e 'using Pkg; Pkg.update()'
else
    cp "${manifest}.default" "$manifest"
    echo "Copied ${manifest}.default to $manifest"
    echo "Instantiating the workspace..."
    julia --project -e 'using Pkg; Pkg.instantiate()'
fi

# Run Pkg.precompile() for a project and abort if any package fails.
# Pkg.precompile() exits 0 even when individual packages fail, so we also grep
# the merged stdout+stderr for failure markers (after stripping ANSI color codes).
# Usage: run_precompile "--project" or run_precompile "--project=examples"
run_precompile() {
    local _proj="$1"
    local _plog
    _plog=$(mktemp)
    set +e
    julia ${_proj} -e 'using Pkg; Pkg.precompile()' 2>&1 | tee "$_plog"
    # Save PIPESTATUS[0] without 'local' to avoid resetting PIPESTATUS
    _precompile_rc=${PIPESTATUS[0]}
    set -e
    # Strip ANSI escape codes, then check for failure markers
    if [[ $_precompile_rc -ne 0 ]] || \
       sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' "$_plog" | grep -qE "Failed to precompile|dependencies? errored"; then
        if [[ "$_proj" == "--project=docs" ]] && \
           grep -q "XML_SetAllocTrackerActivationThreshold" "$_plog" && \
           grep -q "pyexpat" "$_plog"; then
            echo "Warning: Skipping docs precompile due to Conda Python/expat mismatch (pyexpat symbol error)."
            echo "Installation will continue; docs can be precompiled later after repairing the Conda env."
            rm -f "$_plog"
            return 0
        fi
        rm -f "$_plog"
        echo "ERROR: Precompilation failed for ${_proj}. Aborting install."
        exit 1
    fi
    rm -f "$_plog"
}

for _proj in "" examples examples_3d test docs; do
    echo "Precompiling ${_proj:-main} project..."
    run_precompile "--project${_proj:+=$_proj}"
done

if [ ! -f ".JETLSConfig.toml" ] && [ -f ".JETLSConfig.toml.default" ]; then
    cp .JETLSConfig.toml.default .JETLSConfig.toml
    echo "Copied .JETLSConfig.toml.default to .JETLSConfig.toml"
elif [ -f ".JETLSConfig.toml.default" ] && ! cmp -s .JETLSConfig.toml .JETLSConfig.toml.default; then
    echo "Warning: .JETLSConfig.toml differs from .JETLSConfig.toml.default and was not overwritten."
fi

echo
printf "\033[1;32mInstallation complete!\033[0m\n"
echo
echo "You can now launch Julia with bin/run_julia and get the menu with the examples by typing:"
echo "menu()"
if ! julia --startup-file=no -e 'exit(Base.find_package("Revise") === nothing)'; then
    echo
    echo "bin/run_julia needs Revise in your global Julia environment. Add it with:"
    echo "  julia -e 'using Pkg; Pkg.add(\"Revise\")'"
fi
